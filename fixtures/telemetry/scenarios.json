{
  "description": "What the Python and TypeScript SDKs write on each span today. Keys are snake_case and name no language's API; each SDK's test driver maps them to its own. A proof runner loads each scenario in a fresh process with CONVERGENT_RELEASE=r1: it starts the SDK with the `init` options and the `env` variables, runs the `run` tree, then sends everything. `case` says what a scenario proves about its call: success, error, or cancel. `expect.sent` names every span Convergent should receive, its status (UNSET, OK, or ERROR), and every convergent.* and gen_ai.* label it carries, with the exact value. A span not listed, or a convergent.* or gen_ai.* label not listed, fails. Message, tool call, agent tool, and file list labels arrive as JSON text and compare as parsed JSON. `$span_id:<name>` and `$start_time:<name>` (microseconds) stand for the id and start of the one sent span with that name. Every registry key appears here, and every operation has a success case and an error case.",
  "nodes": {
    "agent": "agent_run span named by the value. Span name is `invoke_agent <name>`. Takes what `span` takes.",
    "span": "SDK span with `operation` (default retrieval) named by the value. A tool_call span is named `execute_tool <name>`. `model`, `system_instructions`, `tools`, `attributes`, and `context_attributes` are span options. Inside the span, in order: record `input` as the span's input, record `tool_call_id` as its tool call id, attach each of `artifacts` ({role, text, filename, media_type, origin}) as an input or output file holding the text's bytes, run the `children`, then record `output` as the span's output, or record each of `outputs` as it in turn. `raises: error` then fails the call with an error inside the span, and `raises: cancel` cancels it, each in its language's usual way; the runner catches either outside the span. Inside `input`, `output`, and `tools`, the object `{\"$unportable\": \"nan\"}` stands for the language's not-a-number float and `{\"$unportable\": \"date\"}` for its date type, set to 2026-11-03T00:00:00Z: values JSON cannot hold.",
    "session": "Runs `children` inside a session with this id.",
    "raw": "Plain OpenTelemetry span from the tracer named `scope`, started in the active context with `attributes`. `late_attributes` are set after it starts."
  },
  "scenarios": [
    {
      "name": "agent_run_success",
      "case": "success",
      "run": [
        {
          "agent": "support",
          "model": "gpt-4o",
          "system_instructions": "Answer billing questions.",
          "tools": [{ "name": "lookup_invoice", "description": "Find an invoice by number" }],
          "input": "Where is invoice 1042?",
          "output": "Invoice 1042 was paid."
        }
      ],
      "expect": {
        "sent": {
          "invoke_agent support": {
            "status": "UNSET",
            "attributes": {
              "gen_ai.operation.name": "invoke_agent",
              "gen_ai.agent.name": "support",
              "gen_ai.agent.version": "r1",
              "gen_ai.request.model": "gpt-4o",
              "convergent.agent.system_instructions": "Answer billing questions.",
              "convergent.agent.tools": [
                { "name": "lookup_invoice", "description": "Find an invoice by number" }
              ],
              "gen_ai.input.messages": [
                { "role": "user", "parts": [{ "type": "text", "content": "Where is invoice 1042?" }] }
              ],
              "gen_ai.output.messages": [
                {
                  "role": "assistant",
                  "parts": [{ "type": "text", "content": "Invoice 1042 was paid." }]
                }
              ],
              "convergent.content.source": "sdk",
              "convergent.invocation.span_id": "$span_id:invoke_agent support",
              "convergent.invocation.start_time_unix_micros": "$start_time:invoke_agent support",
              "convergent.root_invocation.span_id": "$span_id:invoke_agent support",
              "convergent.root_invocation.start_time_unix_micros": "$start_time:invoke_agent support"
            }
          }
        }
      }
    },
